// Shared build settings for both apps.
//
// BUNDLE_ID_PREFIX must be unique to you. If Xcode says the bundle identifier is not available,
// change it here (e.g. com.yourname) – both the iPhone and Watch app identifiers derive from it.
BUNDLE_ID_PREFIX = com.firas256

// Optional: your Apple Developer Team ID (10 characters, see developer.apple.com/account).
// You can also just pick your team in Xcode under Signing & Capabilities.
DEVELOPMENT_TEAM =
