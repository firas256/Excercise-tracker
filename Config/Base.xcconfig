// Shared build settings for both apps.
//
// Don't edit this file for signing. Put your own values in Config/Local.xcconfig instead
// (copy Config/Local.xcconfig.example). That file is ignored by git, so `git pull` never
// conflicts with it, and Xcode doesn't need to change the shared project file.

// Both the iPhone and Watch app identifiers derive from this prefix.
BUNDLE_ID_PREFIX = com.firas256

// Your Apple Developer Team ID – set it in Config/Local.xcconfig.
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
